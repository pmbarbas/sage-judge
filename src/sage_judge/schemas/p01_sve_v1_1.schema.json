{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SJ01-SVE/1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sve_id",
    "created_at",
    "theory_id",
    "query",
    "scope",
    "version_tuple",
    "candidate_and_admission_refs",
    "proof_forest",
    "support_proof_roots",
    "refutation_proof_roots",
    "proof_basis_state",
    "proof_posture",
    "evaluation_state",
    "policy_verdict",
    "assumptions",
    "unknowns_and_errors",
    "dependency_closure",
    "boundary_oracle_results",
    "history",
    "integrity",
    "check_result"
  ],
  "properties": {
    "schema_version": {
      "const": "SJ01-SVE/1.1"
    },
    "sve_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string"
    },
    "theory_id": {
      "type": "string"
    },
    "query": {
      "type": "object",
      "required": [
        "predicate_id",
        "typed_arguments",
        "sign_scope",
        "query_id"
      ],
      "properties": {
        "predicate_id": {
          "type": "string"
        },
        "typed_arguments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "value"
            ],
            "properties": {
              "type": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "sign_scope": {
          "const": "BOTH_SIGNS"
        },
        "query_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object"
    },
    "version_tuple": {
      "type": "object",
      "minProperties": 1
    },
    "candidate_and_admission_refs": {
      "type": "object",
      "required": [
        "candidates",
        "admissions"
      ],
      "properties": {
        "candidates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "admissions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "proof_forest": {
      "type": "object",
      "required": [
        "nodes"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "node_id",
              "kind",
              "conclusion",
              "scope_digest",
              "version_digest"
            ],
            "properties": {
              "node_id": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "admitted-premise",
                  "rule-application"
                ]
              },
              "conclusion": {
                "$ref": "#/$defs/atom"
              },
              "scope_digest": {
                "type": "string"
              },
              "version_digest": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": false
    },
    "support_proof_roots": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "refutation_proof_roots": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proof_basis_state": {
      "enum": [
        "COMPLETE_ELEMENTARY_BASIS",
        "INCOMPLETE_BASIS"
      ]
    },
    "proof_posture": {
      "enum": [
        "SUPPORTED",
        "REFUTED",
        "BOTH",
        "UNKNOWN"
      ]
    },
    "evaluation_state": {
      "enum": [
        "COMPLETE",
        "INDETERMINATE",
        "INVALID_INPUT",
        "RESOURCE_LIMIT"
      ]
    },
    "policy_verdict": {
      "type": "object",
      "required": [
        "policy_id",
        "verdict"
      ],
      "properties": {
        "policy_id": {
          "type": "string"
        },
        "verdict": {
          "enum": [
            "PASS",
            "FAIL",
            "REVIEW",
            "NOT_APPLICABLE"
          ]
        }
      },
      "additionalProperties": true
    },
    "assumptions": {
      "type": "array"
    },
    "unknowns_and_errors": {
      "type": "array"
    },
    "dependency_closure": {
      "type": "object"
    },
    "boundary_oracle_results": {
      "type": "array"
    },
    "history": {
      "type": "object"
    },
    "integrity": {
      "type": "object",
      "required": [
        "canonicalization_id",
        "object_digest",
        "referenced_snapshot_digests"
      ],
      "properties": {
        "canonicalization_id": {
          "const": "SJ01-CJSON/1"
        },
        "object_digest": {
          "type": "string"
        },
        "referenced_snapshot_digests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "check_result": {
      "type": "object",
      "required": [
        "validator_result",
        "checker_contract_version",
        "checked_at",
        "trace_id",
        "reason_codes"
      ],
      "properties": {
        "validator_result": {
          "enum": [
            "VALID",
            "INVALID",
            "INDETERMINATE"
          ]
        },
        "checker_contract_version": {
          "type": "string"
        },
        "checked_at": {
          "type": "string"
        },
        "trace_id": {
          "type": "string"
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "atom": {
      "type": "object",
      "required": [
        "sign",
        "predicate",
        "arguments"
      ],
      "properties": {
        "sign": {
          "enum": [
            "+",
            "-"
          ]
        },
        "predicate": {
          "type": "string"
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
